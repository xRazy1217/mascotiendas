Options -Indexes

RewriteEngine On
RewriteBase /

# Sitemap
RewriteRule ^sitemap\.xml$ index.php?sitemap=1 [QSA,L]

# Archivos y carpetas reales pasan directo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demas va a index.php preservando query string
RewriteRule ^ index.php [QSA,L]
