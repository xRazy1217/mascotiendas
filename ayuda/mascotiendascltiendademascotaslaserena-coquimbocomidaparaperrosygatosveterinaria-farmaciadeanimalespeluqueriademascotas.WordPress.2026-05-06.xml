		<title><![CDATA[Bravery Iberian Pork Adult 12kg]]></title>
		<link>https://mascotiendas.cl/https:/mascotiendas.cl/tienda/forza-perro-adulto-20-kgs/bravery-iberian-pork-adult-12kg/</link>
		<pubDate>Sat, 07 Sep 2024 21:45:25 +0000</pubDate>
		<dc:creator><![CDATA[Huerto]]></dc:creator>
